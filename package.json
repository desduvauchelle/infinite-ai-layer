{
  "name": "infinite-ai-layer-workspace",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build:sdk": "pnpm --filter @infinite-ai/core build && pnpm --filter @infinite-ai/providers build",
    "build": "pnpm -r --if-present build && cargo build --workspace",
    "check": "pnpm typecheck && pnpm test && pnpm format:check && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "dev": "pnpm build:sdk && pnpm --filter @infinite-ai/chat-demo dev",
    "format": "prettier --write \"**/*.{json,md,ts,tsx,css,yml,yaml}\" && cargo fmt --all",
    "format:check": "prettier --check \"**/*.{json,md,ts,tsx,css,yml,yaml}\"",
    "test": "pnpm build:sdk && pnpm -r --if-present test",
    "typecheck": "pnpm build:sdk && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
